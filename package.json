{
  "name": "n8n-nodes-scavio",
  "version": "0.22.0",
  "description": "n8n community node for Scavio — real-time structured JSON from Google, Amazon, Walmart, eBay, Target, Home Depot, Costco, Mercado Libre, YouTube, Reddit, TikTok, Instagram, X, LinkedIn, Threads, Kuaishou, Zillow, Redfin, Realtor.com, Rightmove, Booking.com, Airbnb, Tripadvisor, Yelp, Indeed, Glassdoor, App Store, Google Play, SEC EDGAR, Companies House, G2, Capterra, Trustpilot, ad libraries, any URL, and whole websites (map, crawl, batch extract).",
  "keywords": [
    "n8n-community-node-package",
    "scavio",
    "search",
    "google",
    "amazon",
    "walmart",
    "costco",
    "trustpilot",
    "mercadolibre",
    "mercado-libre",
    "mercado-livre",
    "realtor",
    "rightmove",
    "real-estate",
    "youtube",
    "reddit",
    "tiktok",
    "tiktok-shop",
    "ecommerce",
    "instagram",
    "x",
    "linkedin",
    "serp",
    "web-crawler",
    "website-crawl",
    "sitemap",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://scavio.dev",
  "author": {
    "name": "Scavio",
    "email": "scavio.dev@gmail.com",
    "url": "https://scavio.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scavio-ai/n8n-nodes-scavio.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "node scripts/gen-version.js && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "release": "npm version patch && git push --follow-tags"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ScavioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Scavio/Scavio.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.30.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
